    "@polkadot/util-crypto": "^13.4.4",
    "@threefold/tfchain_client": "^2.9.2",
    "cors": "^2.8.5",
    "dotenv": "^10.0.0",
    "express": "^4.21.2",
    "express-pino-logger": "^6.0.0",
    "http-errors": "^1.8.1",
    "jsonschema": "^1.5.0",
